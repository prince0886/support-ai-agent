# ---------------------------------------------------------------------------
# SupportPilot AI - environment variables
# Copy this file to `.env` in the project root. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=demo
# SQLite file. Relative paths resolve inside backend/.
DATABASE_URL=sqlite:///./data/supportpilot.db
SEED_ON_STARTUP=true
DEMO_RESET_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (optional but recommended) -----------------------------------------
# Any OpenAI-compatible chat completions API works: OpenRouter, Ollama, vLLM,
# LM Studio, Together, Groq...
#
# When no key/endpoint is configured, or the provider errors out, SupportPilot
# automatically uses its built-in deterministic analyst (rule-based
# classification + BM25 retrieval + grounded template drafting). The UI shows
# which engine produced each analysis, so nothing is faked.
LLM_ENABLED=true
LLM_PROVIDER=OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400

# OpenRouter also works with its native variable name:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Local open-source model alternative (no API key) -----------------------
# 1. Install Ollama: https://ollama.com
# 2. ollama pull qwen2.5:7b-instruct
# 3. Use these values instead of the OpenRouter block above:
# LLM_PROVIDER=Ollama (local)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=3